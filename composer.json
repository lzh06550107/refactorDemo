{
  "name": "weplatform/weengine-refactor",
  "description": "WeEngine 2.7.4 strangler refactor on ThinkPHP 8",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "topthink/framework": "8.1.3",
    "topthink/think-multi-app": "1.1.1",
    "topthink/think-filesystem": "^3.0",
    "topthink/think-orm": "^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "scripts": {
    "post-autoload-dump": [
      "@php think service:discover",
      "@php think vendor:publish"
    ],
    "test": "php vendor/bin/phpunit",
    "test:offline": "php tests/run.php"
  }
}
